{
  "name": "openyard-site",
  "account_id": "7281c7193a9e8bcd8e0d8ffe1bd17b0a",
  "compatibility_date": "2026-10-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/p/*", "/go/*", "/u/*", "/sitemap.xml", "/projects.json", "/auth/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "openyard", "database_id": "90c96a85-e184-41fb-b6de-324f0a4bed51" }
  ],
  // GitHub stats for the trending list, a few repositories per run
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFzE7AU_0L_sZhiu",
    // GitHub OAuth App for sign-in; its client secret is the GITHUB_CLIENT_SECRET secret
    "GITHUB_CLIENT_ID": "Ov23lifGhhmjkD6yJzue",
    // GitHub logins that can remove any comment
    "ADMIN_LOGINS": "thihodev"
  },
  // Worker Previews: every pull request gets its own preview URL. It uses a separate
  // database (seeded with the same migrations) and no Turnstile or GitHub sign-in,
  // since those only accept openyard.cloud. The cron trigger does not run there.
  "previews": {
    "vars": {
      "TURNSTILE_SITE_KEY": "",
      "GITHUB_CLIENT_ID": "",
      "ADMIN_LOGINS": "thihodev"
    },
    "d1_databases": [
      { "binding": "DB", "database_name": "openyard-preview", "database_id": "86964cba-9462-4365-8aca-ec5ac78dee6b" }
    ]
  },
  "routes": [
    { "pattern": "openyard.cloud", "custom_domain": true },
    { "pattern": "www.openyard.cloud", "custom_domain": true }
  ]
}
